{
  "name": "@oxth/nestjs-otel",
  "version": "0.0.0",
  "description": "OpenTelemetry for NestJS",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/register.*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./register": {
      "import": {
        "types": "./dist/register.d.mts",
        "default": "./dist/register.mjs"
      },
      "require": {
        "types": "./dist/register.d.cts",
        "default": "./dist/register.cjs"
      }
    },
    "./pino": {
      "import": {
        "types": "./dist/pino.d.mts",
        "default": "./dist/pino.mjs"
      },
      "require": {
        "types": "./dist/pino.d.cts",
        "default": "./dist/pino.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/http-overhead.ts"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@nestjs/microservices": "^11.0.0 || ^12.0.0",
    "@nestjs/platform-express": "^11.0.0 || ^12.0.0",
    "@nestjs/platform-fastify": "^11.0.0 || ^12.0.0",
    "@opentelemetry/api": "^1.10.0",
    "nestjs-pino": "*",
    "pino": "*",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    },
    "nestjs-pino": {
      "optional": true
    },
    "@nestjs/platform-express": {
      "optional": true
    },
    "@nestjs/platform-fastify": {
      "optional": true
    },
    "@nestjs/microservices": {
      "optional": true
    }
  },
  "dependencies": {
    "@fastify/otel": "^0.21.4",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.37.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/microservices": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/testing": "^12.3.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "tsdown": "^0.23.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
